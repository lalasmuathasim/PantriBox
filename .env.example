PANTRIBOX_ENV=development

# Backend
PANTRIBOX_API_HOST=0.0.0.0
PANTRIBOX_API_PORT=8000
PANTRIBOX_API_NAME=PantriBox API
PANTRIBOX_API_VERSION=0.1.0
# Required only by backend tooling and the backend process. This value never
# belongs in Flutter configuration. Keep the actual value in ignored backend/.env.
PANTRIBOX_DATABASE_URL=postgresql+psycopg://PANTRIBOX_APP_ROLE:CHANGE_ME@localhost:5433/pantribox
# Optional, local administrator connection used only by the explicit database
# provisioning command. It must never be consumed by the running API.
PANTRIBOX_DATABASE_ADMIN_URL=
PANTRIBOX_LOG_LEVEL=INFO
PANTRIBOX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
PANTRIBOX_JWT_AUDIENCE=pantribox-mobile
PANTRIBOX_JWT_ISSUER=pantribox
PANTRIBOX_DEVELOPMENT_AUTH_SESSION_HOURS=24

# Development-only authentication seed inputs. Keep values in ignored backend/.env.
PANTRIBOX_DEVELOPMENT_SEED_SUPER_ADMIN_NAME=
PANTRIBOX_DEVELOPMENT_SEED_SUPER_ADMIN_EMAIL=
PANTRIBOX_DEVELOPMENT_SEED_SUPER_ADMIN_PASSWORD=
PANTRIBOX_DEVELOPMENT_SEED_NORMAL_USER_NAME=
PANTRIBOX_DEVELOPMENT_SEED_NORMAL_USER_EMAIL=
PANTRIBOX_DEVELOPMENT_SEED_NORMAL_USER_PASSWORD=
PANTRIBOX_PRODUCT_DATA_PROVIDER_BASE_URL=https://world.openfoodfacts.org
PANTRIBOX_PRODUCT_DATA_PROVIDER_USER_AGENT=PantriBox/0.1 (contact@example.com)
PANTRIBOX_PRODUCT_DATA_PROVIDER_TIMEOUT_SECONDS=5
PANTRIBOX_PRODUCT_LOOKUP_FRESHNESS_HOURS=720
PANTRIBOX_PRODUCT_LOOKUP_NEGATIVE_CACHE_HOURS=24

# Mobile
PANTRIBOX_MOBILE_API_BASE_URL=http://10.0.2.2:8000/api/v1
